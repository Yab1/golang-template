{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yab1/golang-template/docs/eventing/schemas/notification-queued.v1.schema.json",
  "title": "NotificationQueued v1",
  "allOf": [
    {
      "$ref": "./cloudevents-envelope.v1.schema.json"
    },
    {
      "properties": {
        "type": {
          "const": "dev.yab1.golangtemplate.notification.queued.v1"
        },
        "subject": {
          "pattern": "^urn:notification:[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "dataschema": {
          "const": "/docs/eventing/schemas/notification-queued.v1.schema.json"
        },
        "data": {
          "type": "object",
          "required": [
            "notification_id",
            "reference_id",
            "user_id",
            "channel",
            "category",
            "status",
            "version"
          ],
          "properties": {
            "notification_id": {
              "type": "string",
              "format": "uuid"
            },
            "reference_id": {
              "type": "string",
              "pattern": "^[A-Z0-9]+-NTF-[A-Z0-9]{5}$"
            },
            "user_id": {
              "type": "string",
              "format": "uuid"
            },
            "channel": {
              "type": "string",
              "enum": ["email", "sms", "push", "in_app", "telegram"]
            },
            "category": {
              "type": "string",
              "enum": ["welcome", "alert", "status", "transactional"]
            },
            "status": {
              "type": "string",
              "enum": ["pending", "skipped"]
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      }
    }
  ],
  "x-registry-subject": "dev.yab1.golangtemplate.notification-queued.v1"
}
