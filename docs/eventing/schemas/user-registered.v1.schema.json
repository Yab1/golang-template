{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yab1/golang-template/docs/eventing/schemas/user-registered.v1.schema.json",
  "title": "UserRegistered v1",
  "allOf": [
    {
      "$ref": "./cloudevents-envelope.v1.schema.json"
    },
    {
      "properties": {
        "type": {
          "const": "dev.yab1.golangtemplate.user.registered.v1"
        },
        "subject": {
          "pattern": "^urn:user:[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "dataschema": {
          "const": "/docs/eventing/schemas/user-registered.v1.schema.json"
        },
        "data": {
          "type": "object",
          "required": ["user_id", "reference_id", "is_active", "is_visible", "version"],
          "properties": {
            "user_id": {
              "type": "string",
              "format": "uuid"
            },
            "reference_id": {
              "type": "string",
              "pattern": "^[A-Z0-9]+-USR-[A-Z0-9]{5}$"
            },
            "is_active": {
              "type": "boolean"
            },
            "is_visible": {
              "type": "boolean"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      }
    }
  ],
  "x-registry-subject": "dev.yab1.golangtemplate.user-registered.v1"
}
