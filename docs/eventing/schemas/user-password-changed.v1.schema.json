{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yab1/golang-template/docs/eventing/schemas/user-password-changed.v1.schema.json",
  "title": "UserPasswordChanged v1",
  "allOf": [
    {
      "$ref": "./cloudevents-envelope.v1.schema.json"
    },
    {
      "properties": {
        "type": {
          "const": "dev.yab1.golangtemplate.user.password-changed.v1"
        },
        "subject": {
          "pattern": "^urn:user:[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "dataschema": {
          "const": "/docs/eventing/schemas/user-password-changed.v1.schema.json"
        },
        "data": {
          "type": "object",
          "required": ["user_id", "change_reason", "sessions_revoked", "version"],
          "properties": {
            "user_id": {
              "type": "string",
              "format": "uuid"
            },
            "change_reason": {
              "type": "string",
              "enum": ["user_change", "password_reset"]
            },
            "sessions_revoked": {
              "const": true
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      }
    }
  ],
  "x-registry-subject": "dev.yab1.golangtemplate.user-password-changed.v1"
}
