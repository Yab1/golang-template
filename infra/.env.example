# Copy to .env: cp .env.example .env
# Loaded by compose (ports/command/healthcheck) and by containers (env_file where used).

# --- postgres ---
# Matches root DB_ADDR: postgres://admin:password@localhost:5432/golang_template?sslmode=disable
POSTGRES_IMAGE_TAG=18
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=golang_template
POSTGRES_PORT=5432

# --- redis ---
# App .envrc: REDIS_ADDR=localhost:6379 and REDIS_PW must equal REDIS_PASSWORD here.
REDIS_IMAGE_TAG=8.2.5-alpine
REDIS_PORT=6379
REDIS_PASSWORD=dev-redis-change-me
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# --- kafka ---
# App: KAFKA_BROKERS=localhost:9092  |  UI: http://localhost:${KAFKA_UI_PORT}
KAFKA_IMAGE_TAG=latest
KAFKA_UI_IMAGE_TAG=main
KAFKA_PORT=9092
KAFKA_UI_PORT=7070

# --- schema registry ---
# App: KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081
# (worker health uses EVENT_WORKER_ADDR=:8082 — do not collide)
SCHEMA_REGISTRY_IMAGE_TAG=7.6.1
SCHEMA_REGISTRY_PORT=8081

# --- mailpit ---
# App MAIL_DRIVER=smtp → SMTP_HOST=localhost SMTP_PORT=1025
# UI: http://localhost:${MAILPIT_UI_PORT}
MAILPIT_IMAGE_TAG=latest
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- minio ---
# App: STORAGE_DRIVER=minio S3_ENDPOINT=localhost:9000 S3_BUCKET=uploads
# Console: http://localhost:${MINIO_CONSOLE_PORT}
MINIO_IMAGE_TAG=RELEASE.2025-09-07T16-13-09Z
MINIO_MC_IMAGE_TAG=latest
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=uploads
