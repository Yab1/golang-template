# Copy to .env: cp .env.example .env
# Loaded by compose (ports/command/healthcheck) and by containers (env_file where used).

# --- postgres ---
# Matches root DB_ADDR: postgres://admin:password@localhost:5432/golang_template?sslmode=disable
POSTGRES_IMAGE_TAG=18
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=golang_template
POSTGRES_PORT=5432

# --- redis ---
# App .envrc: REDIS_ADDR=localhost:6379 and REDIS_PW must equal REDIS_PASSWORD here.
REDIS_IMAGE_TAG=8.2.5-alpine
REDIS_PORT=6379
REDIS_PASSWORD=dev-redis-change-me
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# --- kafka ---
# App: KAFKA_BROKERS=localhost:9092  |  UI: http://localhost:${KAFKA_UI_PORT}
KAFKA_IMAGE_TAG=latest
KAFKA_UI_IMAGE_TAG=main
KAFKA_PORT=9092
KAFKA_UI_PORT=7070
