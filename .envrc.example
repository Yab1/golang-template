# Copy to .envrc and adjust. Then: direnv allow
# Shared deps: cd infra && make up (postgres, redis, kafka, kafka-ui).
# App key catalog for local (this file) and deploy/.env (same names, no export; docker DNS).
# Sections match internal/platform/config/*.go loaders.

# --- app ---
export ADDR=:8080
export ENV=development
export APP_NAME=golang-template
# 3-letter platform prefix for human reference ids: GTL-USR-A7K2M
export REF_PREFIX=GTL

# --- log ---
export LOG_LEVEL=debug
export LOG_FORMAT=console

# --- http ---
export PUBLIC_BASE_URL=http://localhost:8080
export CORS_ENABLED=true
export CORS_ALLOWED_ORIGINS=*
export SHUTDOWN_TIMEOUT=10s
# CIDRs that may send X-Forwarded-For / X-Real-IP. Empty = trust RemoteAddr only.
export TRUSTED_PROXIES=

# --- swagger ---
export SWAGGER_ENABLED=true
export SWAGGER_TITLE=Golang Template API
export SWAGGER_DESCRIPTION=REST API template: auth (access+refresh), RBAC, posts, files, mail, rate limiting, reference ids.
export SWAGGER_VERSION=0.0.1
export SWAGGER_TOS=https://www.google.com/policies/terms/
export SWAGGER_CONTACT_NAME=Yeabsera
export SWAGGER_CONTACT_EMAIL=yeabsera.dev@gmail.com
export SWAGGER_CONTACT_URL=https://yeabsera-dev.vercel.app/
export SWAGGER_EXTERNAL_DOCS_URL=https://yeabsera-dev.vercel.app/
export SWAGGER_EXTERNAL_DOCS_DESC=External documentation

# --- database ---
export DB_ADDR=postgres://admin:password@localhost:5432/golang_template?sslmode=disable
export DB_MAX_CONNS=30
export DB_MIN_CONNS=2
export DB_MAX_CONN_IDLE_TIME=15m
export DB_EXPECTED_SCHEMA_VERSION=6

# --- auth ---
export AUTH_REQUIRED=true
export RBAC_ENABLED=true
export AUTH_TOKEN_SECRET=dev-secret-change-me
export AUTH_TOKEN_EXP=15m
export AUTH_REFRESH_EXP=168h
export AUTH_TOKEN_ISS=golang-template
export AUTH_TOKEN_AUD=golang-template
# Require email verification before login (seed admin is always active)
export AUTH_EMAIL_VERIFY_REQUIRED=true
export AUTH_VERIFY_TOKEN_EXP=24h
export AUTH_RESET_TOKEN_EXP=1h
# Authorization: Bearer $AUTH_DEV_TOKEN  (skips JWT; needs AUTH_DEV_USER_ID)
export AUTH_DEV_TOKEN=dev-token
export AUTH_DEV_USER_ID=

# --- seed (idempotent admin via POST stage: make post / scripts/release.sh) ---
export SEED_ENABLED=false
export SEED_ADMIN_EMAIL=admin@localhost
export SEED_ADMIN_USERNAME=admin
export SEED_ADMIN_PASSWORD=
export SEED_ADMIN_ROLE=admin

# --- redis ---
export REDIS_ADDR=localhost:6379
# Must match infra/.env REDIS_PASSWORD when using ./infra redis.
export REDIS_PW=dev-redis-change-me
export REDIS_DB=0
export REDIS_ENABLED=true

# --- rate limit ---
export RATE_LIMIT_ENABLED=true
export RATE_LIMIT_AUTH=10
export RATE_LIMIT_WRITE=120
export RATE_LIMIT_READ=600

# --- files / blob ---
# STORAGE_DRIVER: local | s3 | minio
export FILES_ENABLED=true
export STORAGE_DRIVER=local
export STORAGE_LOCAL_DIR=./tmp/uploads
export STORAGE_PUBLIC_URL=http://localhost:8080/api/v1/files
export FILE_MAX_BYTES=10485760
export FILE_ALLOWED_TYPES=image/jpeg,image/png,image/webp,application/pdf
export S3_ENDPOINT=localhost:9000
export S3_REGION=us-east-1
export S3_BUCKET=uploads
export S3_ACCESS_KEY=minioadmin
export S3_SECRET_KEY=minioadmin
export S3_USE_SSL=false
export S3_PATH_STYLE=true

# --- mail ---
# MAIL_DRIVER: log | smtp | ses
export MAIL_ENABLED=true
export MAIL_DRIVER=log
export MAIL_FROM=noreply@localhost
export MAIL_FROM_NAME=golang-template
export SMTP_HOST=localhost
export SMTP_PORT=1025
export SMTP_USER=
export SMTP_PASS=
export SMTP_TLS=false
export SMTP_STARTTLS=false
export SES_REGION=us-east-1
export SES_ACCESS_KEY=
export SES_SECRET_KEY=

# --- metrics ---
export METRICS_ENABLED=false
# Required outside development. Header X-Metrics-Token or Authorization: Bearer
export METRICS_TOKEN=

# --- audit ---
export AUDIT_ENABLED=true

# --- kafka / eventing ---
export KAFKA_ENABLED=false
export KAFKA_BROKERS=localhost:9092
export KAFKA_CLIENT_ID=golang-template
export KAFKA_USERNAME=
export KAFKA_PASSWORD=
export KAFKA_TLS=false
export KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081
export KAFKA_TOPIC_PREFIX=development.golang-template
# Worker health/metrics (must not collide with schema registry :8081)
export EVENT_WORKER_ADDR=:8082
# all | relay | consumer
export EVENT_WORKER_MODE=all
export EVENT_CONSUMER_NAME=event-logger
export EVENT_OUTBOX_BATCH_SIZE=100
export EVENT_OUTBOX_POLL_INTERVAL=1s
export EVENT_OUTBOX_CLAIM_LEASE=30s
export EVENT_CONSUMER_MAX_ATTEMPTS=4
export EVENT_RETRY_DELAY_1=1m
export EVENT_RETRY_DELAY_2=10m
export EVENT_RETRY_DELAY_3=1h
export EVENT_WORKER_SHUTDOWN_TIMEOUT=30s
